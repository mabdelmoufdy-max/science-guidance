{
  "redirects": [
    { "source": "/app", "destination": "/app/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/app/manifest.webmanifest", "destination": "/app-manifest.webmanifest" },
    { "source": "/app/", "destination": "https://mabdelmoufdy-max.github.io/science-guidance/" },
    { "source": "/app/:path*", "destination": "https://mabdelmoufdy-max.github.io/science-guidance/:path*" },
    { "source": "/coordinator", "destination": "https://mabdelmoufdy-max.github.io/science-guidance/trial/coordinator-entry/" },
    { "source": "/coordinator/", "destination": "https://mabdelmoufdy-max.github.io/science-guidance/trial/coordinator-entry/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/coordinator(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/coordinator(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/app/trial/coordinator-v190/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
